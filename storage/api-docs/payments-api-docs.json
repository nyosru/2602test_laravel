{
    "openapi": "3.0.0",
    "info": {
        "title": "Payments API",
        "description": "API для просмотра баланса и управления платежами пользователей",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "Payments API"
        }
    ],
    "paths": {
        "/api/payments": {
            "get": {
                "tags": [
                    "Payments"
                ],
                "summary": "Получить список платежей",
                "description": "Возвращает список платежей пользователя с пагинацией. По умолчанию используются платежи текущего пользователя.",
                "operationId": "afcbc19a07bf33c2fcb73b5c438b476c",
                "parameters": [
                    {
                        "name": "user_id",
                        "in": "query",
                        "description": "ID пользователя, для которого нужно получить платежи. По умолчанию — текущий пользователь.",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 2
                        }
                    },
                    {
                        "name": "direction",
                        "in": "query",
                        "description": "Направление платежей: to — в сторону пользователя, from — от пользователя.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "to",
                                "from"
                            ],
                            "example": "to"
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Количество элементов на странице (макс. 100)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 15,
                            "maximum": 100
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список платежей успешно получен",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaymentsListSuccessResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не авторизован",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthorizedError"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Payments"
                ],
                "summary": "Создать платёж",
                "description": "Создаёт платёж в сторону пользователя или от пользователя. По умолчанию платёж относится к текущему пользователю.",
                "operationId": "985b848b4cb6ca6115cf4ea71e314c0c",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "direction",
                                    "amount"
                                ],
                                "properties": {
                                    "user_id": {
                                        "description": "ID пользователя, к которому относится платёж. Если не указано — используется текущий пользователь.",
                                        "type": "integer",
                                        "example": 10,
                                        "nullable": true
                                    },
                                    "direction": {
                                        "description": "Направление платежа: to — в сторону пользователя, from — от пользователя.",
                                        "type": "string",
                                        "enum": [
                                            "to",
                                            "from"
                                        ],
                                        "example": "to"
                                    },
                                    "amount": {
                                        "description": "Сумма платежа",
                                        "type": "number",
                                        "format": "float",
                                        "example": 1500.5
                                    },
                                    "currency": {
                                        "description": "Валюта в формате ISO 4217 (3 символа). По умолчанию RUB.",
                                        "type": "string",
                                        "example": "RUB"
                                    },
                                    "status": {
                                        "description": "Статус платежа. По умолчанию pending.",
                                        "type": "string",
                                        "example": "pending"
                                    },
                                    "description": {
                                        "description": "Описание платежа",
                                        "type": "string",
                                        "example": "Оплата услуги",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Платеж успешно создан",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaymentCreatedResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Ошибка запроса",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не авторизован",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthorizedError"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/payments/balance": {
            "get": {
                "tags": [
                    "Payments"
                ],
                "summary": "Получить текущий баланс пользователя",
                "description": "Публичный эндпоинт. Возвращает текущий баланс пользователя по платежам со статусом completed. Пользователь указывается только по user_id.",
                "operationId": "a3e5914513908952e9e8667fd6f07336",
                "parameters": [
                    {
                        "name": "user_id",
                        "in": "query",
                        "description": "ID пользователя, для которого нужно получить баланс.",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 2
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Баланс успешно получен",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaymentBalanceSuccessResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/payments/{id}": {
            "get": {
                "tags": [
                    "Payments"
                ],
                "summary": "Получить платёж по ID",
                "description": "Показать один платёж.",
                "operationId": "33da95d13a42b4c3898427d7cb9516a8",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID платежа",
                        "required": true,
