                            }
                        }
                    },
                    "401": {
                        "description": "Не авторизован",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthorizedError"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Платеж не найден",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NotFoundError"
                                }
                            }
                        }
                    }
                }
            },
            "patch": {
                "tags": [
                    "Payments"
                ],
                "summary": "Обновить платёж",
                "description": "Частичное обновление платежа.",
                "operationId": "f944e15bb4846164dd54961a3beed951",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID платежа",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "direction": {
                                        "description": "Направление платежа: to — в сторону пользователя, from — от пользователя.",
                                        "type": "string",
                                        "enum": [
                                            "to",
                                            "from"
                                        ],
                                        "example": "to"
                                    },
                                    "amount": {
                                        "description": "Сумма платежа",
                                        "type": "number",
                                        "format": "float",
                                        "example": 1500.5
                                    },
                                    "currency": {
                                        "description": "Валюта в формате ISO 4217 (3 символа).",
                                        "type": "string",
                                        "example": "RUB"
                                    },
                                    "status": {
                                        "description": "Статус платежа.",
                                        "type": "string",
                                        "example": "pending"
                                    },
                                    "description": {
                                        "description": "Описание платежа",
                                        "type": "string",
                                        "example": "Оплата услуги",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Платеж успешно обновлён",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaymentSuccessResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не авторизован",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthorizedError"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Доступ к платежу запрещён",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ForbiddenError"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Платеж не найден",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NotFoundError"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
