                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NotFoundError"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Payments"
                ],
                "summary": "Удалить платёж",
                "description": "Удалить платёж.",
                "operationId": "4db359e13e73e2832ead474820546c40",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID платежа",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Платеж успешно удалён",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaymentDeletedResponse"
